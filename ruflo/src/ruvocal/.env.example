# N3XUS Flow — valores padrão do chat-ui (sem segredos).
# O Dockerfile copia este arquivo para /app/.env; a configuração real vem de
# DOTENV_LOCAL (o entrypoint grava /app/.env.local), definida no Coolify.
# Só para o build (o prerender lista modelos e a ponte ainda não existe);
# em execução o DOTENV_LOCAL troca por http://mcp-bridge:3001.
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=
PUBLIC_APP_NAME=N3XUS Flow
PUBLIC_APP_ASSETS=chatui
PUBLIC_APP_DESCRIPTION="Orquestração de agentes de IA da N3XUS"
PUBLIC_ORIGIN=
PUBLIC_SHARE_PREFIX=
PUBLIC_GOOGLE_ANALYTICS_ID=
PUBLIC_PLAUSIBLE_SCRIPT_URL=
PUBLIC_APPLE_APP_ID=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SCOPES="openid profile"
OPENID_CONFIG=
OPENID_NAME_CLAIM="name"
OPENID_PROVIDER_URL=
OPENID_TOLERANCE=
OPENID_RESOURCE=
USE_USER_TOKEN=false
AUTOMATIC_LOGIN=false
COUPLE_SESSION_WITH_COOKIE_NAME=
ALLOWED_USER_EMAILS=[]
ALLOWED_USER_DOMAINS=[]
ALTERNATIVE_REDIRECT_URLS=[]
COOKIE_NAME=n3xus-flow
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
TRUSTED_EMAIL_HEADER=
ADMIN_CLI_LOGIN=false
ADMIN_TOKEN=
ADMIN_API_SECRET=
LLM_SUMMARIZATION=true
ALLOW_IFRAME=false
MCP_SERVERS=
MCP_FORWARD_HF_USER_TOKEN=false
EXA_API_KEY=
MCP_TOOL_TIMEOUT_MS=
ENABLE_DATA_EXPORT=true
USAGE_LIMITS={}
HF_ORG_ADMIN=
HF_ORG_EARLY_ACCESS=
WEBHOOK_URL_REPORT_ASSISTANT=
METRICS_ENABLED=false
METRICS_PORT=5565
LOG_LEVEL=info
PARQUET_EXPORT_DATASET=
PARQUET_EXPORT_HF_TOKEN=
PARQUET_EXPORT_SECRET=
ENABLE_CONFIG_MANAGER=false
APP_BASE=""
BODY_SIZE_LIMIT=15728640
PUBLIC_COMMIT_SHA=
ALLOW_INSECURE_COOKIES=false
LLM_ROUTER_ARCH_BASE_URL=
LLM_ROUTER_ROUTES_PATH=
LLM_ROUTER_ARCH_MODEL=
LLM_ROUTER_OTHER_ROUTE=casual_conversation
LLM_ROUTER_FALLBACK_MODEL=
LLM_ROUTER_ARCH_TIMEOUT_MS=10000
LLM_ROUTER_MAX_ASSISTANT_LENGTH=500
LLM_ROUTER_MAX_PREV_USER_LENGTH=400
LLM_ROUTER_ENABLE_MULTIMODAL=
LLM_ROUTER_MULTIMODAL_MODEL=
LLM_ROUTER_ENABLE_TOOLS=
LLM_ROUTER_TOOLS_MODEL=
PUBLIC_LLM_ROUTER_DISPLAY_NAME=Omni
PUBLIC_LLM_ROUTER_LOGO_URL=
PUBLIC_LLM_ROUTER_ALIAS_ID=omni
TRANSCRIPTION_MODEL=
